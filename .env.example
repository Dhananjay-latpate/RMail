# =============================================================================
# RMail Multi-Organization Mail Server - Environment Configuration
# =============================================================================
# Copy this file to .env and update ALL values before deploying.
#
# IMPORTANT: Never commit .env files with real credentials to version control.

# =============================================================================
# Docker Compose Deployment (Mail Platform)
# =============================================================================

# ---- PostgreSQL Database Settings ----
POSTGRES_DB=stalwart
POSTGRES_USER=stalwart
POSTGRES_PASSWORD=CHANGE_ME

# ---- Admin Settings ----
# Password for the fallback administrator account (user: admin)
ADMIN_SECRET=CHANGE_ME

# ---- Server Settings ----
# Primary hostname for this mail server (used in MX, TLS, autoconfig)
MAIL_HOSTNAME=mail.example.com

# ---- Enterprise License ----
# Required for multi-tenant SaaS. Obtain from https://stalw.art/enterprise
ENTERPRISE_LICENSE_KEY=CHANGE_ME

# ---- Database Connection URL ----
# Constructed automatically in docker-compose.yml from the above values.

# =============================================================================
# Product Control Plane (product/docker-compose.yml)
# =============================================================================

# Product API
PRODUCT_API_PORT=4000
PRODUCT_DATABASE_URL=postgresql://product:CHANGE_ME@product-postgres:5432/rmail_product
JWT_SECRET=CHANGE_ME

# RMail Management API (used by product API for provisioning)
RMAIL_API_URL=http://stalwart:8080
RMAIL_ADMIN_USER=admin
RMAIL_ADMIN_SECRET=CHANGE_ME

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_STARTER=price_CHANGE_ME
STRIPE_PRICE_BUSINESS=price_CHANGE_ME
STRIPE_PRICE_ENTERPRISE=price_CHANGE_ME

# Portal (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
PORTAL_PORT=3000

# Webmail
WEBMAIL_PORT=3001
NEXT_PUBLIC_WEBMAIL_API_URL=http://localhost:8080

# =============================================================================
# Railway Deployment (HTTP-only; not suitable for full SMTP/IMAP)
# =============================================================================
# DATABASE_URL=              # Auto-provided by Railway PostgreSQL plugin
# PORT=                      # Auto-provided by Railway
# ADMIN_SECRET=              # REQUIRED
# MAIL_HOSTNAME=             # REQUIRED
# ENTERPRISE_LICENSE_KEY=    # REQUIRED for multi-tenant
