# =============================================================================
# RMail Multi-Organization Mail Server - Environment Configuration
# =============================================================================
# Copy this file to .env and update ALL values before deploying.
#
# ⚠️  IMPORTANT: Never commit .env files with real credentials to version control.

# =============================================================================
# Docker Compose Deployment
# =============================================================================

# ---- PostgreSQL Database Settings ----
POSTGRES_DB=stalwart
POSTGRES_USER=stalwart
POSTGRES_PASSWORD=          # REQUIRED: Set a strong password (e.g., openssl rand -base64 32)

# ---- Admin Settings ----
# Password for the fallback administrator account (user: admin)
ADMIN_SECRET=               # REQUIRED: Set a strong admin password

# ---- Server Settings ----
# The primary hostname for this mail server
MAIL_HOSTNAME=mail.example.com

# ---- Database Connection URL ----
# Constructed automatically in docker-compose.yml from the above values.
# For standalone use, set this directly:
# DB_URL=postgresql://stalwart:YOUR_PASSWORD@localhost:5432/stalwart

# =============================================================================
# Railway Deployment
# =============================================================================
# When deploying on Railway, set these in the Railway dashboard.
# Railway's PostgreSQL plugin will provide DATABASE_URL automatically.
#
# DATABASE_URL=              # Auto-provided by Railway PostgreSQL plugin
# PORT=                      # Auto-provided by Railway
# ADMIN_SECRET=              # REQUIRED: Set in Railway dashboard
# MAIL_HOSTNAME=             # REQUIRED: Your mail server hostname
